{
  "name": "akilii-desktop",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "akilii desktop development foundation",
  "author": "The FullSpektrum Group",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "package:mac": "electron-packager . akilii --platform=darwin --arch=arm64,x64 --out=out/0.1.0-alpha.4 --overwrite --icon=icons/akilii.icns --protocol=akilii --protocolName=akilii --ignore='^/out($|/)'",
    "package:win": "electron-packager . akilii --platform=win32 --arch=x64 --out=out/0.1.0-alpha.4 --overwrite --icon=icons/akilii.ico --ignore='^/out($|/)'",
    "prestart": "node build-shared.mjs",
    "prepackage:mac": "node build-shared.mjs",
    "prepackage:win": "node build-shared.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "@electron/packager": "20.3.0"
  }
}
