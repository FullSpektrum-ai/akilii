# Required: shared only between the akilii backend and the private runtime gateway.
AKILII_FLOWSTATE_TOKEN=replace-with-a-long-random-token-at-least-32-characters

# Local gateway binding. Keep this loopback-only; Caddy reaches the gateway over Docker networking.
AKILII_FLOWSTATE_PORT=8788

# Configure at least one provider for a real alpha.9 turn.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional live smoke-test override. When omitted, the smoke test selects
# gpt-5.4-mini when OPENAI_API_KEY is present, then Claude Haiku 4.5 when
# ANTHROPIC_API_KEY is present.
AKILII_SMOKE_MODEL_ID=
AKILII_SMOKE_MODEL_PROVIDER=
AKILII_SMOKE_MODEL_LABEL=

# Required only for `npm run flowstate:up:public`.
FLOWSTATE_PUBLIC_HOST=

# Optional. Defaults to the pinned alpha.9 image built by flowstate:build.
# FLOWSTATE_IMAGE=flowstate-backend:alpha9-40e022bd4e0c

# Optional. Used when selecting the Ollama/local-model profile.
# OLLAMA_HOST=http://ollama:11434
